# FreshMart Backend - PRODUCTION ENVIRONMENT SETUP
# This file is documentation only - DO NOT commit actual .env.production to git!
# Follow these instructions to deploy securely.

# ============================================
# IMPORTANT SECURITY NOTICE
# ============================================
# NEVER commit .env.production file to Git!
# NEVER store secrets in your code!
# NEVER share credentials via email/chat/Slack!
# Always use your deployment platform's secret management!

# ============================================
# DEPLOYMENT PLATFORM SETUP INSTRUCTIONS
# ============================================

# FOR VERCEL DEPLOYMENT:
# ───────────────────────
# 1. Go to https://vercel.com/projects/[project-name]/settings/environment-variables
# 2. Click "Add New"
# 3. Set Production environment
# 4. Add each variable below as a separate entry
# 5. Deploy will automatically use these values

# FOR HEROKU DEPLOYMENT:
# ────────────────────────
# 1. Use Heroku CLI:
#    heroku login
#    heroku config:set MONGO_URL="your-production-uri" -a your-app-name
#    heroku config:set JWT_SECRET="your-secret" -a your-app-name
# 
# 2. Or go to: https://dashboard.heroku.com/apps/[app-name]/settings
#    Click "Reveal Config Vars" and add each variable

# FOR AWS (EC2/Lambda) DEPLOYMENT:
# ────────────────────────────────
# 1. Using Systems Manager Parameter Store:
#    aws ssm put-parameter --name /freshmart-backend/MONGO_URL --value "..." --type SecureString
#    aws ssm put-parameter --name /freshmart-backend/JWT_SECRET --value "..." --type SecureString
#
# 2. Or use AWS Secrets Manager:
#    aws secretsmanager create-secret --name freshmart-backend-env --secret-string '{"MONGO_URL":"...","JWT_SECRET":"..."}'

# FOR DOCKER DEPLOYMENT:
# ─────────────────────
# 1. Create docker-compose.yml with:
#    services:
#      backend:
#        environment:
#          - MONGO_URL=${MONGO_URL}
#          - JWT_SECRET=${JWT_SECRET}
#
# 2. Run: docker-compose --env-file .env.production up
# 3. Or use: docker run -e MONGO_URL="..." -e JWT_SECRET="..." image-name

# ============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ============================================

# MongoDB Atlas Connection (Production Database)
# Create a dedicated MongoDB user with production password
# Enable IP Whitelist for your deployment server ONLY
MONGO_URL=mongodb+srv://production_user:STRONG_PASSWORD@production-cluster.mongodb.net/freshmart?retryWrites=true&w=majority&ssl=true

# JWT Secret (PRODUCTION - Different from development!)
# MUST be: Random, long (32+ chars), complex, unique
# Generate with: openssl rand -base64 32
# Store securely - never share or version control
JWT_SECRET=your-production-jwt-secret-generate-with-openssl-rand-base64-32

# Server Port (most platforms use 8080, Heroku uses $PORT variable)
PORT=8080

# Environment Flag
NODE_ENV=production

# Frontend URLs (Production)
FRONTEND_URL_1=https://the-freshmart.vercel.app
FRONTEND_URL_2=https://your-production-domain.com

# ============================================
# SECURITY BEST PRACTICES CHECKLIST
# ============================================
# ☐ Use strong, randomly generated JWT_SECRET (minimum 32 characters)
# ☐ Use MongoDB Atlas with:
#    ☐ Dedicated database user (not root/admin)
#    ☐ Strong password (auto-generated by MongoDB Atlas)
#    ☐ IP whitelist: Only your server's IP
#    ☐ TLS/SSL enabled (mongodb+srv:// protocol)
# ☐ Different credentials for dev, staging, and production
# ☐ Store secrets in platform's secret manager (NOT git)
# ☐ Use environment-specific values (not shared across envs)
# ☐ Rotate JWT_SECRET periodically (every 90 days)
# ☐ Monitor database access logs for suspicious activity
# ☐ Use HTTPS for all API calls (enforced in production)
# ☐ Enable database backups and test restore procedures
# ☐ Set up alerts for failed authentication attempts
# ☐ Review and update Node.js dependencies regularly

# ============================================
# QUICK SETUP COMMANDS
# ============================================

# 1. Generate a secure JWT_SECRET:
#    macOS/Linux: openssl rand -base64 32
#    Windows (PowerShell): [Convert]::ToBase64String((1..32 | ForEach-Object {Get-Random -Maximum 256}))

# 2. Test database connection locally:
#    node -e "require('mongoose').connect('MONGO_URL').then(() => console.log('✅ Connected')).catch(e => console.log('❌ Error:', e.message))"

# 3. Verify environment setup:
#    node -e "console.log({MONGO_URL: !!process.env.MONGO_URL, JWT_SECRET: !!process.env.JWT_SECRET})"

# ============================================
# EMERGENCY PROCEDURES
# ============================================

# If JWT_SECRET is compromised:
# 1. Generate new JWT_SECRET immediately
# 2. Update in deployment platform
# 3. Redeploy application
# 4. All existing tokens become invalid (users re-login)

# If MongoDB password is compromised:
# 1. Change password in MongoDB Atlas immediately
# 2. Update MONGO_URL in deployment platform
# 3. Redeploy application
# 4. Review access logs for unauthorized access

# If database is breached:
# 1. Immediately take backup
# 2. Notify affected users
# 3. Consider password reset for all users
# 4. Implement additional monitoring
# 5. Review and strengthen security

# ============================================
# SUPPORT & DOCUMENTATION
# ============================================
# MongoDB Atlas: https://docs.atlas.mongodb.com/
# JWT Best Practices: https://tools.ietf.org/html/rfc8725
# OWASP Secrets Management: https://cheatsheetseries.owasp.org/cheatsheets/Secrets_Management_Cheat_Sheet.html
# Node.js Security: https://nodejs.org/en/docs/guides/security/
